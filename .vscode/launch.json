{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LUCA Frontend (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/flask_app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/frontend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      }
    },
    {
      "name": "Ingesta completa",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ingesta: sólo prácticas (sin LLM)",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest",
      "args": ["--only", "practicas"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ingesta: soluciones que no cumplen las reglas",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest",
      "args": ["--only", "soluciones", "--regenerar-no-conformes"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ingesta: apuntes",
      "type": "debugpy",
      "request": "launch",
      "module": "ingest",
      "args": ["--only", "apuntes"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
