# LUCA para direnv: copiá a .envrc, completá los valores y corré `direnv allow`.
# Nunca commitees .envrc con valores reales. Variables opcionales: ver .env.example.

export OPENAI_API_KEY="CHANGEME"

export DEFAULT_LLM_MODEL="gpt-6-luna"
export DEFAULT_LLM_PROVIDER="openai"
export DEFAULT_LLM_TEMPERATURE="0.1"    # Ignorada por gpt-6-* y o-series (solo aceptan 1)

# Apuntes en Chroma (docker compose up -d chroma; python -m ingest --only apuntes)
export CHROMA_HOST="localhost"
export CHROMA_PORT="8001"
export CHROMA_COLLECTION="apuntes"
export EMBEDDING_MODEL="text-embedding-3-small"

export FLASK_SECRET_KEY="CHANGEME"

export GUARDRAILS_CONTENT_SAFETY_METHOD="llm"
export GUARDRAILS_ENABLE_OPENAI_MODERATION="false"
