# LUCA: copiá este archivo a .env (o .envrc con `export`) y completá los valores.
# Nunca commitees el archivo con valores reales.

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# LLM del tutor
DEFAULT_LLM_MODEL=gpt-6-luna
DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_TEMPERATURE se ignora con gpt-6-* y o-series (solo aceptan 1)
DEFAULT_LLM_TEMPERATURE=0.1
DEFAULT_LLM_MAX_TOKENS=4096
DEFAULT_LLM_TIMEOUT=60

# Apuntes en Chroma (docker compose up -d chroma; python -m ingest --only apuntes)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=apuntes
EMBEDDING_MODEL=text-embedding-3-small

# Datos (opcionales; por defecto data/luca.db y artifacts/practicas.json)
# LUCA_DB_PATH=data/luca.db
# PRACTICAS_PATH=artifacts/practicas.json

# Flask
FLASK_SECRET_KEY=your-secure-secret-key-for-production
LUCA_ENABLE_HTTPS=false

# Guardrails (opcionales; estos son los valores por defecto)
# GUARDRAILS_CONTENT_SAFETY_METHOD: "llm" o "moderation_api"
GUARDRAILS_CONTENT_SAFETY_METHOD=llm
GUARDRAILS_ENABLE_OPENAI_MODERATION=false
GUARDRAILS_ENABLE_PROFANITY_FILTER=true
GUARDRAILS_ENABLE_EDUCATIONAL_VALIDATION=true
GUARDRAILS_ENABLE_RATE_LIMITING=true
GUARDRAILS_ENABLE_RESPONSE_VALIDATION=true
GUARDRAILS_STRICT_ACADEMIC_MODE=false
GUARDRAILS_ALLOW_GENERAL_KNOWLEDGE=true
GUARDRAILS_MAX_REQUESTS_PER_MINUTE=30
GUARDRAILS_MAX_REQUESTS_PER_HOUR=200
GUARDRAILS_MAX_REQUESTS_PER_DAY=1000
